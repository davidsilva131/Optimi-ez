{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimi-ez",
  "version": "0.1.0",
  "identifier": "dev.optimiez.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Optimi-ez",
        "width": 1080,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
